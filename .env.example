# ---------------------------------------------------------------------------
# Diapason - variables d'environnement. Copier vers .env.local puis completer.
# Aucune valeur reelle ne doit etre commitee.
# ---------------------------------------------------------------------------

# Adaptateur de donnees : "demo" (local, donnees fictives) ou "supabase".
# "demo" fonctionne sans aucune autre variable.
DIAPASON_DATA_ADAPTER=demo

# Secret de signature des cookies de session de l'adaptateur demo.
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DIAPASON_SESSION_SECRET=

# Fuseau par defaut des communautes creees.
DIAPASON_DEFAULT_TIMEZONE=Europe/Paris

# ---------------------------------------------------------------------------
# Supabase (requis uniquement si DIAPASON_DATA_ADAPTER=supabase)
# Noms de variables de la generation actuelle de cles : "publishable" cote
# navigateur, "secret" strictement cote serveur.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# JAMAIS exposee au navigateur, reservee au worker de notifications et aux
# taches d'administration.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email (optionnel). Sans cle, l'outbox reste en etat "enregistre" et
# l'interface n'affiche jamais "email envoye".
# ---------------------------------------------------------------------------
DIAPASON_EMAIL_PROVIDER=none
RESEND_API_KEY=
DIAPASON_EMAIL_FROM=
