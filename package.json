{
  "name": "diapason",
  "version": "0.1.0",
  "private": true,
  "description": "Diapason — planning des ministeres ICC (premier cas d'usage : MLA La Defense)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "node --conditions=react-server --import tsx scripts/seed-demo.ts",
    "reset:demo": "node --conditions=react-server --import tsx scripts/reset-demo.ts",
    "outbox": "node --conditions=react-server --import tsx scripts/process-outbox.ts",
    "analyse:classeur": "node --conditions=react-server --import tsx scripts/analyse-workbook.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
